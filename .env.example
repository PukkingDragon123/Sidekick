# Sidekick server configuration.
# Copy to `.env` in the repository root; the server loads it on start (variables already set
# in the environment win over this file). Everything is optional: with an empty file you get
# accounts, sync, presence/teleport, iCal imports, reminders, push and the offline planner.
# See docs/SERVER.md for the setup steps behind each block.

# ---- Core -------------------------------------------------------------------

# Port for HTTP and WebSocket.
PORT=8787

# Interface to listen on. 0.0.0.0 lets phones and tablets on the same network reach it.
HOST=0.0.0.0

# The URL people (and Google, Microsoft, Stripe) use to reach this server, without a trailing
# slash. OAuth redirect URIs are built from it:
#   <PUBLIC_URL>/api/integrations/google/callback
#   <PUBLIC_URL>/api/integrations/microsoft/callback
# Default: http://localhost:<PORT>
#PUBLIC_URL=https://sidekick.example.org

# Browser origins that may call the API from another origin (comma separated). The web client
# served by this server itself never needs to be listed. Default is the Vite dev server.
CORS_ORIGINS=http://localhost:5173

# Set to true only behind a reverse proxy you control: the client IP for rate limiting is then
# taken from the last X-Forwarded-For entry (the one your proxy appended).
#TRUST_PROXY=false

# Registrations / pair-code attempts allowed per IP address per 10 minutes (each has its own
# budget). Raise it if a whole class signs up from one school network address.
#AUTH_RATE_MAX=30

# ---- Storage ----------------------------------------------------------------

# Where sidekick.db and secret.key live. Default: server/data
#SIDEKICK_DATA_DIR=/var/lib/sidekick

# Full path of the SQLite file, if it should not be <data dir>/sidekick.db
#SIDEKICK_DB=/var/lib/sidekick/sidekick.db

# Key material for encrypting stored credentials (OAuth tokens, calendar feed links, the VAPID
# private key) with AES-256-GCM. Any long random string: `openssl rand -hex 32`.
# If unset, a key is generated once into <data dir>/secret.key. Losing or changing it means
# every school account has to be connected again. Back it up separately from the database.
#SIDEKICK_SECRET=

# ---- AI (the sidekick's chat and the AI planner) ------------------------------

# AI is on only when one of these two is set. Without it /api/health reports ai:false, chat
# answers with the `no_ai` event and plans come from the offline planner.
#ANTHROPIC_API_KEY=sk-ant-...
#ANTHROPIC_AUTH_TOKEN=

# Only if requests must go through a gateway instead of api.anthropic.com. Read by the
# Anthropic SDK itself. Setting it does not switch AI on.
#ANTHROPIC_BASE_URL=

# Model for chat and planning. It must support adaptive thinking and the effort setting.
#SIDEKICK_MODEL=claude-opus-5-5

# How much thinking each route spends: low | medium | high | xhigh | max.
# Lower is faster and cheaper; chat is a speech bubble, planning weighs a whole week.
#SIDEKICK_CHAT_EFFORT=low
#SIDEKICK_PLAN_EFFORT=medium

# Messages per account per UTC day (an AI plan counts as one message).
#AI_FREE_PER_DAY=40
#AI_PLUS_PER_DAY=400

# What happens when a safety classifier declines a request: `default` lets the API re-run it
# on the fallback model Anthropic recommends for that case (beta header
# server-side-fallback-2026-07-01); `off` returns the refusal as an error to the student.
#SIDEKICK_FALLBACKS=default

# Stream tool inputs as they are generated. On by default when talking to the Anthropic API
# directly, off by default behind ANTHROPIC_BASE_URL because gateways may reject the field.
#SIDEKICK_EAGER_TOOL_INPUT=true

# ---- Google Classroom (docs/SERVER.md, "Google Classroom") ---------------------

#GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=GOCSPX-...

# ---- Microsoft Teams for Education (docs/SERVER.md, "Microsoft Teams") ---------

#MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
#MS_CLIENT_SECRET=
# Sign-in authority. `organizations` = any school or work tenant (multi-tenant app
# registration). For a single-tenant registration put the tenant ID or domain here.
#MS_TENANT=organizations

# OAuth callbacks must arrive in the browser that asked for the consent page (checked with a
# short-lived cookie). Leave on. `off` is for clients that open the consent page in a
# different browser than the one holding the device token, and removes that protection.
#OAUTH_BROWSER_BINDING=on

# Re-pull connected school sources in the background every N minutes, so new assignments and
# their "due soon" nudges arrive without the app being opened. 0 = only when a client asks.
#AUTO_SYNC_MINUTES=0

# ---- Web Push ---------------------------------------------------------------

# VAPID key pair. If unset, a pair is generated once and kept (encrypted) in the database,
# which is fine for a single server. Generate your own with: npx web-push generate-vapid-keys
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=

# Contact for push services (mailto: or https: URL). Apple's service rejects placeholders,
# so set a real address in production. Default: PUBLIC_URL when it is https.
#VAPID_SUBJECT=mailto:you@example.org

# ---- Billing: Sidekick Plus through Stripe (all three, or billing stays off) ---

#STRIPE_SECRET_KEY=sk_test_...
# A recurring price (price_...), not a product id.
#STRIPE_PRICE_ID=price_...
# Signing secret of the webhook endpoint <PUBLIC_URL>/api/billing/webhook (whsec_...).
#STRIPE_WEBHOOK_SECRET=whsec_...
